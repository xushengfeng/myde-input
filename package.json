{
  "name": "myde-input",
  "version": "1.0.0",
  "description": "High-performance Linux input device reader",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "bin"],
  "scripts": {
    "build:rust": "cargo build --release --manifest-path rust/Cargo.toml && mkdir -p bin && cp rust/target/release/myde-input-reader ./bin/myde-input-reader-$(node -e \"console.log(process.platform + '-' + process.arch)\")",
    "build:ts": "vite build",
    "build": "pnpm build:ts",
    "dev": "vite",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["linux", "input", "evdev", "keyboard", "mouse", "touchscreen"],
  "author": "xsf",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^3.0.0",
    "msgpackr": "^1.11.0"
  }
}
